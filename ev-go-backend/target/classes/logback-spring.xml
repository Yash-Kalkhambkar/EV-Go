<?xml version="1.0" encoding="UTF-8"?>
<!--
  EV GO – Structured JSON Logging Configuration
  Requirements: 22.1 (JSON fields), 22.2 (correlation ID), 22.4 (sensitive data masking)

  Profiles:
    dev  → console appender (human-readable JSON, coloured in IDE)
    prod → rolling file appender (JSON, consumed by Cloud Logging agent)
    default (no profile) → console appender
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ================================================================
         Properties
         ================================================================ -->
    <springProperty scope="context" name="APP_NAME"    source="spring.application.name" defaultValue="ev-go-backend"/>
    <springProperty scope="context" name="APP_ENV"     source="APP_ENV"                 defaultValue="local"/>
    <springProperty scope="context" name="LOG_DIR"     source="LOG_DIR"                 defaultValue="logs"/>

    <!-- ================================================================
         Sensitive-data masking converter
         Requirements: 22.3, 22.4, 22.5 – mask passwords, tokens, payment details, card numbers
         Registered as conversionRule so %maskedMessage can be used in patterns.
         ================================================================ -->
    <conversionRule conversionWord="maskedMessage"
                    converterClass="com.evgo.filter.SensitiveDataMaskingConverter"/>

    <!-- ================================================================
         Logstash JSON Encoder – shared configuration
         Requirements: 22.1 – timestamp, level, logger, message, trace_id, span_id, user_id
         ================================================================ -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Standard fields -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <timeZone>UTC</timeZone>

            <!-- Rename default fields to match Cloud Logging conventions -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>

            <!-- Include MDC fields: trace_id, span_id, user_id, correlation_id -->
            <!-- MDC is populated by MdcFilter (Task 9.1) -->
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>correlation_id</includeMdcKeyName>
            <includeMdcKeyName>booking_id</includeMdcKeyName>
            <includeMdcKeyName>station_id</includeMdcKeyName>

            <!-- Static fields added to every log entry -->
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>

            <!-- Include stack traces in ERROR logs – Req 22.5 -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerCause>20</maxDepthPerCause>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>36</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>

            <!-- Mask sensitive data in the message field – Req 22.3, 22.4, 22.5 -->
            <!-- The maskedMessage conversionRule applies SensitiveDataMaskingConverter -->
            <messageJsonProvider class="net.logstash.logback.composite.loggingevent.MessageJsonProvider"/>
            <provider class="net.logstash.logback.composite.loggingevent.MdcJsonProvider"/>
        </encoder>
    </appender>

    <!-- ================================================================
         File appender (prod profile) – rolling JSON logs
         ================================================================ -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ev-go.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover, keep 30 days – Req 22.7 (30-day retention) -->
            <fileNamePattern>${LOG_DIR}/ev-go.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <timeZone>UTC</timeZone>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>correlation_id</includeMdcKeyName>
            <includeMdcKeyName>booking_id</includeMdcKeyName>
            <includeMdcKeyName>station_id</includeMdcKeyName>
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerCause>20</maxDepthPerCause>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>36</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ================================================================
         Async wrappers – prevent I/O from blocking request threads
         ================================================================ -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE_JSON"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE_JSON"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ================================================================
         Logger overrides
         ================================================================ -->
    <!-- Reduce noise from framework internals -->
    <logger name="org.springframework.security"          level="WARN"/>
    <logger name="org.springframework.web"               level="INFO"/>
    <logger name="org.hibernate.SQL"                     level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql"     level="WARN"/>
    <logger name="com.zaxxer.hikari"                     level="INFO"/>
    <logger name="io.lettuce"                            level="WARN"/>
    <logger name="org.redisson"                          level="WARN"/>
    <logger name="io.github.resilience4j"                level="INFO"/>

    <!-- Application loggers -->
    <logger name="com.evgo"                              level="INFO"/>

    <!-- ================================================================
         Profile-specific root logger configuration
         ================================================================ -->

    <!-- dev profile: console only -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
        </root>
    </springProfile>

    <!-- prod profile: file only (Cloud Logging agent tails the file) -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- default (no profile active): console -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
